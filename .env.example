# Copie ce fichier en ".env" et remplis tes vraies valeurs. Ne jamais commit le .env !

PORT=3000
BASE_URL=http://localhost:3000

# --- MonCash (Digicel) ---
# À obtenir sur https://sandbox.moncashbutton.digicelgroup.com (mode test)
# puis sur https://moncashbutton.digicelgroup.com (mode production)
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
MONCASH_MODE=sandbox
# sandbox ou production

# --- NatCash (Natcom) ---
# NatCash n'a pas d'API publique de paiement en ligne standard.
# Le flux est donc "manuel avec vérification" : le client paie au numéro
# ci-dessous via *202# ou l'app Natcash, puis colle sa référence de transaction
# sur le site. Toi (l'admin) valides ensuite la commande.
NATCASH_MERCHANT_NUMBER=
NATCASH_MERCHANT_NAME=

# --- Admin ---
# Mot de passe simple pour accéder à /admin (à changer absolument)
ADMIN_TOKEN=change-moi
